# Copy to config/experiment.env and edit. Sourced by scripts/*.sh.
# Path to PolyBench/C 4.2.1 (cloned by scripts/get_polybench.sh)
POLYBENCH_DIR=$HOME/PolyBenchC-4.2.1
# Search settings used in the paper
BUDGET=20          # evaluations per search
SEEDS=5            # random seeds 0..4
# Output folder for run_all.py (the dashboard reads ./results by default)
OUT_DIR=results
# Python virtual environment
VENV_DIR=venv
